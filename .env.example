# Local secrets only. No provider keys belong in Unity Assets or player builds.
UNITY_EDITOR_PATH=/home/jbud/Unity/Hub/Editor/6000.6.0f1/Editor/Unity
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=
LITELLM_MASTER_KEY=
MODEL_DEFAULT=general
MODEL_SUPERVISOR=supervisor
MODEL_COMBAT=code
MODEL_SYSTEMS=code
MODEL_WORLD=code
MODEL_ART=general
MODEL_DESIGN=general
MODEL_QA=review
MESHY_API_KEY=

# LiteLLM deployment settings. Set provider-prefixed model IDs available to you.
# Examples: anthropic/<model-id>, gemini/<model-id>, ollama_chat/<model-id>.
SUPERVISOR_UPSTREAM_MODEL=openrouter/anthropic/claude-sonnet-5.5
CODE_UPSTREAM_MODEL=openrouter/anthropic/claude-sonnet-5.5
GENERAL_UPSTREAM_MODEL=openrouter/deepseek/deepseek-v4.1-flash-1017
REVIEW_UPSTREAM_MODEL=openrouter/openai/gpt-6.1-sol
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Routed task profiles. Specialist MODEL_* values above override these defaults.
MODEL_CODE=code
MODEL_REASONING=supervisor
MODEL_GENERAL=general
MODEL_REVIEW=review
MODEL_VISION=
OPENROUTER_API_KEY=

# Langfuse Cloud: explicit project region and keys. Enable only after setting all three.
ENABLE_LANGFUSE=false
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
YENDOR_MAIL_PORT=18765
# Optional isolated verification copy from: npm run unity:prepare
UNITY_PROJECT_PATH=
